# Скопируйте в terraform.tfvars и при необходимости поправьте значения.

region      = "eu-central-1"
environment = "demo"
project     = "cinema"

cluster_version = "1.30"

# Размер node group
node_instance_types = ["m5.large"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 5

# RDS SQL Server (демо)
rds_instance_class = "db.t3.large"
rds_multi_az       = false
# rds_master_username = "cinema_admin"   # 'sa' в RDS запрещён
