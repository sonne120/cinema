# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project files
# Central package/build settings — must be present before restore
COPY Directory.Build.props Directory.Packages.props ./
COPY src/Cinema.ServiceDiscovery/Cinema.ServiceDiscovery.csproj src/Cinema.ServiceDiscovery/
COPY src/Cinema.MasterNode/Cinema.MasterNode.csproj src/Cinema.MasterNode/

# Restore dependencies for Cinema.MasterNode project
RUN dotnet restore src/Cinema.MasterNode/Cinema.MasterNode.csproj

# Copy everything else
COPY src/ src/

# Build the application
WORKDIR /src/src/Cinema.MasterNode
RUN dotnet build Cinema.MasterNode.csproj -c Release -o /app/build

# Stage 2: Publish
FROM build AS publish
WORKDIR /src/src/Cinema.MasterNode
RUN dotnet publish Cinema.MasterNode.csproj -c Release -o /app/publish /p:UseAppHost=false

# Stage 3: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

# curl is not present in the aspnet runtime image; HEALTHCHECK below needs it
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy published files
COPY --from=publish /app/publish .

# Expose port
EXPOSE 8080

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl --fail http://localhost:8080/ || exit 1

# Run the application
ENTRYPOINT ["dotnet", "Cinema.MasterNode.dll"]
