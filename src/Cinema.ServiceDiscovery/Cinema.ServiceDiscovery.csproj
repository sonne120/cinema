<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consul service discovery + self-registration.

    Deliberately standalone rather than living in Cinema.Infrastructure: the
    gateway, load balancer and read service need to register themselves but have
    no business depending on EF Core, SQL Server or the Mongo driver.
  -->
  <ItemGroup>
    <PackageReference Include="Consul" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
