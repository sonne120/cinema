<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- EF Core for SQL Server (Write Side) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- MongoDB (Read Side) -->
    <PackageReference Include="MongoDB.Driver" />

    <!-- Kafka -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- Background Jobs -->
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Extensions.Hosting" />

    <!-- Serialization -->
    <PackageReference Include="Newtonsoft.Json" />

    <!-- Authentication & JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="BCrypt.Net-Next" />

    <!-- Service Discovery -->
    <PackageReference Include="Consul" />

    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cinema.Application\Cinema.Application.csproj" />
    <ProjectReference Include="..\Cinema.Persistence.Read\Cinema.Persistence.Read.csproj" />
    <ProjectReference Include="..\Cinema.ServiceDiscovery\Cinema.ServiceDiscovery.csproj" />
  </ItemGroup>

</Project>
